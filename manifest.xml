<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xsi:type="TaskPaneApp">

  <Id>5298a2c8-07f9-4aa4-8727-1ffd42c19287</Id>
  <Version>1.3.2.0</Version>
  <ProviderName>Julie Van</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Layout Shortcuts" />
  <Description DefaultValue="Keyboard shortcuts for aligning, distributing, resizing, arranging, and editing text in PowerPoint." />
  <IconUrl DefaultValue="https://julievan.github.io/layout-shortcuts/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://julievan.github.io/layout-shortcuts/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/julievan/layout-shortcuts" />

  <AppDomains>
    <AppDomain>https://julievan.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Presentation" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://julievan.github.io/layout-shortcuts/src/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.1">
        <bt:Set Name="SharedRuntime" MinVersion="1.1" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="Presentation">
        <Runtimes>
          <Runtime resid="Commands.Url" lifetime="long" />
        </Runtimes>
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="LayoutShortcutsGroup">
                <Label resid="LayoutShortcutsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="ShowHelpButton">
                  <Label resid="ShowHelpButton.Label" />
                  <Supertip>
                    <Title resid="ShowHelpButton.Label" />
                    <Description resid="ShowHelpButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>LayoutShortcutsTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://julievan.github.io/layout-shortcuts/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://julievan.github.io/layout-shortcuts/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://julievan.github.io/layout-shortcuts/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://julievan.github.io/layout-shortcuts/src/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://julievan.github.io/layout-shortcuts/src/taskpane.html" />
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://github.com/julievan/layout-shortcuts" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Layout Shortcuts is loaded" />
        <bt:String id="LayoutShortcutsGroup.Label" DefaultValue="Layout Shortcuts" />
        <bt:String id="ShowHelpButton.Label" DefaultValue="Shortcuts" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open the task pane for the full list of keyboard shortcuts." />
        <bt:String id="ShowHelpButton.Tooltip" DefaultValue="Show the list of layout keyboard shortcuts." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
  <ExtendedOverrides Url="https://julievan.github.io/layout-shortcuts/shortcuts.json" />
</OfficeApp>
